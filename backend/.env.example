PAYLOAD_SECRET=change-me-to-a-long-random-string

# Public URL of this Payload instance (admin + API). Used for CSRF/CORS
# defaults, metadataBase and absolute URLs. Set to https://cms.baitbuzz.com
# in production.
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000

# API key for POST /api/ingest/raw-posts (Chrome extension bulk ingest).
# Leave empty to disable the endpoint.
INGEST_API_KEY=

# Leave empty for local SQLite dev (payload.db).
# Set to your Supabase Postgres connection string to use Supabase:
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Port 6543 = transaction pooler (recommended for serverless).
# Port 5432 = session pooler (fine for local dev; small client limit).
DATABASE_URL=

# Comma-separated extra origins allowed for CORS/CSRF — add your
# white-label site domains here (e.g. https://site2.com,https://cms2.site2.com).
PAYLOAD_ALLOWED_ORIGINS=

# Frontend revalidation — after CMS edits, Payload POSTs here so the
# reader site drops its cached API responses immediately.
# Must point at the frontend's /api/revalidate endpoint and share the
# same REVALIDATE_SECRET as the frontend.
FRONTEND_REVALIDATE_URL=http://localhost:5173/api/revalidate
REVALIDATE_SECRET=
