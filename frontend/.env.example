# White-label site identity (optional — defaults to baitbuzz branding).
# Set these to run a second site from the same codebase.
PUBLIC_SITE_NAME=baitbuzz
PUBLIC_SITE_TAGLINE=AI & tech content, synthesized from the best discussions on social media.
PUBLIC_SITE_DESCRIPTION=AI & tech news synthesized from social posts, rewritten in our own words.

# URL PayloadCMS REST API
PUBLIC_PAYLOAD_API=http://localhost:3000/api

# Public site base URL (used for canonical, OG, sitemap, RSS)
PUBLIC_SITE_URL=http://localhost:5173

# Google Analytics 4 measurement ID (optional, e.g. G-XXXXXXXXXX).
# Leave empty to disable analytics.
PUBLIC_GA_ID=

# Shared secret for POST /api/revalidate — the backend calls this after
# CMS edits to bust the API cache. Must match the backend REVALIDATE_SECRET.
REVALIDATE_SECRET=
